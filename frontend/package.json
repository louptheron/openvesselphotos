{
  "name": "openvesselphotos-frontend",
  "description": "Open Vessel Photos web application.",
  "version": "0.0.0",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24",
    "npm": "11"
  },
  "scripts": {
    "build": "rm -Rf ./build && vite build",
    "dev": "vite --port 3000",
    "format": "prettier --write ./src",
    "test:format": "prettier --check ./src",
    "test:lint": "oxlint --config=.oxlintrc.json src",
    "test:lint:fix": "oxlint --fix --config=.oxlintrc.json src && prettier --write ./src",
    "test:type": "tsc",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@reduxjs/toolkit": "2.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "9.3.0",
    "react-router-dom": "6.27.0",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "0.2.2",
    "@tsconfig/vite-react": "8.1.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
