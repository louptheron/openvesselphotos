################################################################################
# Server Configuration

# Set by Scalingo, takes precedence over OPENVESSELPHOTOS_SERVER_PORT
PORT=
OPENVESSELPHOTOS_SERVER_PORT=

################################################################################
# Database Configuration

# Set by Scalingo (PostgreSQL addon), take precedence over OPENVESSELPHOTOS_DATABASE_URL
SCALINGO_POSTGRESQL_URL=
DATABASE_URL=
OPENVESSELPHOTOS_DATABASE_URL=
OPENVESSELPHOTOS_DATABASE_HIKARI_MAX_POOL_SIZE=

################################################################################
# Public URL (canonical links, sitemap)

OPENVESSELPHOTOS_PUBLIC_URL=

################################################################################
# Client IP and rate limits

# X-Real-IP on Scalingo. Empty = TCP address (never set it without a proxy that controls the header)
OPENVESSELPHOTOS_CLIENT_IP_HEADER=
# Behind Cloudflare's proxy: the client IP is then CF-Connecting-IP, on requests coming from Cloudflare only
OPENVESSELPHOTOS_BEHIND_CLOUDFLARE=false
OPENVESSELPHOTOS_RATE_LIMIT_READS_PER_MINUTE=
OPENVESSELPHOTOS_RATE_LIMIT_WRITES_PER_HOUR=
OPENVESSELPHOTOS_RATE_LIMIT_API_KEY_WRITES_PER_HOUR=
OPENVESSELPHOTOS_RATE_LIMIT_API_KEY_REQUESTS_PER_HOUR=

################################################################################
# Admin

OPENVESSELPHOTOS_ADMIN_PASSWORD=
